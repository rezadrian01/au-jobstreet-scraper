# GCP project that has the Vertex AI API enabled. Gemini calls are billed to it.
GCP_PROJECT_ID=""

# Vertex region, e.g. global, us-central1 or asia-southeast1. Model availability varies
# by region: https://cloud.google.com/vertex-ai/generative-ai/docs/learn/locations
GCP_LOCATION="global"

# Service account with the "Vertex AI User" role. Copy client_email and private_key from
# its JSON key file; keep the private key on one line with \n between lines.
# Leave both empty to use your gcloud login instead (gcloud auth application-default login).
GCP_CLIENT_EMAIL=""
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n\n-----END PRIVATE KEY-----\n"

# Apify API token, for the Glints source. Create one at
# https://console.apify.com/settings/integrations (Settings > API & Integrations).
APIFY_TOKEN=""
